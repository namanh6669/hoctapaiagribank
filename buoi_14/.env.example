# Buổi 14 — Mini Knowledge Graph loader env vars
# Sao chép file này thành `.env` và điền thông tin thật:
#     cp buoi_14/.env.example buoi_14/.env
#
# Tuyệt đối KHÔNG commit file `.env` (chứa password).
# Loader đọc qua python-dotenv; thiếu biến nào sẽ SKIP push lên Neo4j.

# Địa chỉ Neo4j (vd: bolt://localhost:7687 / neo4j+s://xxx.databases.neo4j.io:7687)
NEO4J_URI=

# Tên người dùng (thường là 'neo4j' cho local)
NEO4J_USER=neo4j

# Mật khẩu — KHÔNG hardcode trong script.
NEO4J_PASSWORD=

# Tên database (mặc định 'neo4j'; có thể đặt 'buoi_14' để cô lập)
NEO4J_DATABASE=neo4j

# Tùy chọn: ép dùng FALLBACK ngay cả khi có Neo4j (chỉ chạy in-memory + emit Cypher)
# DRY_RUN=1

# Tùy chọn: chạy cleanup dữ liệu cũ của buoi_14 trước khi nạp lại (MẶC ĐỊNH: 0)
#   Lệnh thực thi:
#     MATCH (n) WHERE n.lab_session = 'buoi_14' DETACH DELETE n
#     MATCH ()-[r]->() WHERE r.lab_session = 'buoi_14' DELETE r
#   Script sẽ hỏi xác nhận trước khi chạy.
# CLEAN_PREVIOUS=0
