# Neo4j connection settings for graph_rag_labs.
# Copy this file to `.env.graph_rag` and fill in your real password.
#
#   cp .env.graph_rag.template .env.graph_rag
#   $EDITOR .env.graph_rag

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YourSecurePassword123
NEO4J_DATABASE=neo4j

# Optional — name of the vector index to create.
NEO4J_VECTOR_INDEX=chunk_embedding

# Gemini API key for generation (Bước 7). Get one from
# https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-flash-latest